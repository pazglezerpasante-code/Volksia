# URL del centro de herramientas que se embebe en la pestaña "Herramientas".
VITE_WORKSPACE_URL=https://pazglezerpasante-code.github.io/volksia-workspace/

# OAuth opcional: configurar solo en el servidor, sin prefijo VITE_.
# Sin secreto, el acceso OAuth mediante el broker queda deshabilitado.
GROK_AUTH_CLIENT_ID=grok_preview
GROK_AUTH_CLIENT_SECRET=
