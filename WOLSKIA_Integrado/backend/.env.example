# Configuración INTERNA del servidor (no se muestra en la web).
# Los usuarios finales solo chatean; no ven ni cargan claves.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional (respaldo)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── Agente (herramientas) ───────────────────────────────────────────────
# Por defecto solo la cuenta "admin" puede crear/modificar archivos. Con 1, también "trabajador".
WOLSKIA_WORKERS_CAN_WRITE=0
# Archivo donde se guarda «Tu espacio» (por defecto backend/data/espacio.json)
# WOLSKIA_SPACE_FILE=
