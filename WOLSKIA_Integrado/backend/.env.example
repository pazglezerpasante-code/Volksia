# Configuración INTERNA del servidor (no se muestra en la web).
# Los usuarios finales solo chatean; no ven ni cargan claves.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional (respaldo)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ─── Agente (herramientas) ───────────────────────────────────────────────
# Por defecto solo la cuenta "admin" puede crear/modificar archivos. Con 1, también "trabajador".
WOLSKIA_WORKERS_CAN_WRITE=0
# Archivo donde se guarda «Tu espacio» (por defecto backend/data/espacio.json)
# WOLSKIA_SPACE_FILE=

# ─── Despliegue online (sitio público SIN login) ─────────────────────────
# Estas variables se cargan en Render (Environment), NO en GitHub.
# WOLSKIA_PUBLIC_MODE=1            activa las protecciones del modo público
# WOLSKIA_PROXY_SECRET=            clave larga y secreta; el MISMO valor va en Vercel
# WOLSKIA_GLOBAL_DAILY_LIMIT=300   tope de consultas de IA por día para todo el sitio
# SUPABASE_URL=                    (opcional) guarda «Tu espacio» en Supabase
# SUPABASE_SERVICE_KEY=            (opcional) clave service_role de Supabase (secreta)
