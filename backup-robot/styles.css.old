@import "tailwindcss";

@theme {
  --color-bg: #050b13;
  --color-side: #07121c;
  --color-panel: #0a1622;
  --color-panel-2: #0d1c2c;
  --color-line: #172b40;
  --color-fg: #e8f1fb;
  --color-muted: #8fa5bc;
  --color-accent: #2f8dff;
  --color-accent-2: #6ad4ff;
  --color-ok: #3dd6a4;
  --color-warn: #e0a14a;
  --font-sans: "IBM Plex Sans", "Segoe UI", sans-serif;
  --font-display: "Sora", "IBM Plex Sans", "Segoe UI", sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, monospace;
  --radius: 1rem;
}

@layer base {
  html, body, #root { height: 100%; }
  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-fg);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
  }
  button:not(:disabled), [role="button"]:not(:disabled) { cursor: pointer; }
  input, textarea { font: inherit; color: inherit; }
  h1, h2 { font-family: var(--font-display); }
  ::selection { background: rgba(47,141,255,0.35); color: #fff; }
  :focus-visible { outline: 2px solid var(--color-accent-2); outline-offset: 2px; border-radius: 0.5rem; }
  * { scrollbar-width: thin; scrollbar-color: #1c3350 transparent; }
}

/* ---- Fondo aurora + cuadricula sutil ---- */
.wol-aurora {
  position: relative;
  isolation: isolate;
  background:
    radial-gradient(60rem 40rem at 12% -10%, rgba(47,141,255,0.20), transparent 60%),
    radial-gradient(50rem 36rem at 105% 10%, rgba(106,212,255,0.12), transparent 60%),
    radial-gradient(40rem 30rem at 50% 120%, rgba(61,214,164,0.07), transparent 60%),
    var(--color-bg);
}
.wol-aurora::before {
  content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
  background-image:
    linear-gradient(rgba(106,212,255,0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(106,212,255,0.045) 1px, transparent 1px);
  background-size: 44px 44px;
  mask-image: radial-gradient(ellipse at 50% 30%, #000 25%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse at 50% 30%, #000 25%, transparent 75%);
}

/* ---- Vidrio ---- */
.glass {
  background: linear-gradient(160deg, rgba(13,28,44,0.78), rgba(8,18,30,0.72));
  border: 1px solid rgba(106,212,255,0.14);
  box-shadow: 0 1px 0 rgba(255,255,255,0.05) inset, 0 24px 60px -24px rgba(0,0,0,0.65);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

/* ---- Boton principal ---- */
.wol-btn {
  background: linear-gradient(135deg, #2f8dff, #38b6ff);
  color: #04101c; font-weight: 600;
  box-shadow: 0 8px 24px -10px rgba(47,141,255,0.7), 0 1px 0 rgba(255,255,255,0.35) inset;
  transition: filter .2s ease, box-shadow .2s ease;
}
.wol-btn:hover:not(:disabled) { filter: brightness(1.08); box-shadow: 0 10px 28px -8px rgba(47,141,255,0.85), 0 1px 0 rgba(255,255,255,0.35) inset; }

/* ---- Sugerencias clickeables: cambian de color, no de lugar ---- */
.wol-suggest { transition: border-color .2s ease, background .2s ease, color .2s ease; }
.wol-suggest:hover { border-color: rgba(106,212,255,0.55); background: rgba(47,141,255,0.10); }

/* ---- Entrada unica (login) ---- */
@keyframes wol-rise {
  from { opacity: 0; transform: translateY(14px) scale(.985); }
  to { opacity: 1; transform: none; }
}
.wol-rise { animation: wol-rise .6s cubic-bezier(.2,.8,.2,1) both; }

/* ---- Mensajes del chat ---- */
@keyframes wol-pop { from { opacity: 0; } to { opacity: 1; } }
.wol-msg { animation: wol-pop .25s ease-out both; }

/* Scroll sin barra visible (la rueda y el tactil siguen funcionando) */
.no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
.no-scrollbar::-webkit-scrollbar { display: none; }

@keyframes wol-breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-3px); }
}
@keyframes wol-spin {
  to { transform: rotate(360deg); }
}
@keyframes wol-scan {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(220%); }
}
@keyframes wol-blink {
  0%, 42%, 100% { transform: scaleY(1); }
  46%, 50% { transform: scaleY(0.12); }
}
@keyframes wol-pulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .robot-stage, .robot-eyes, .robot-scan, .robot-ring, .wol-rise, .wol-msg { animation: none !important; }
  .gnav-ind { transition: none !important; }
}


/* ═══ Icon bar (Bencho, MIT — bencho.dev/licence) ═════════════
   Bencho's tokens, mapped onto what WOLSKIA already uses for the
   same job. They are defined on .gnav itself so nothing leaks
   out to the rest of the app.

   ink / pane       -> the app's foreground and its panel colour
   pane-thumb       -> a wash of the accent, so the selected slot
                       hints at the brand blue
   bar-slot/pad/gap -> one 44px slot; gap and padding stay in
                       proportion to it
   g-*              -> the glass recipe: frost, a lit rim that is
                       bright only at the corner facing the light,
                       and a soft lift underneath
   ink-rgb and shadow-rgb are three bare numbers, because the
   CSS builds rgba() from them. */
.icon-bar { display: flex; justify-content: center; }

.gnav {
  --ink: var(--color-fg);
  --ink-rgb: 232, 241, 251;
  --pane: rgba(10, 22, 34, 0.55);
  --pane-edge: var(--color-line);
  --pane-thumb: rgba(106, 212, 255, 0.16);
  --shadow-rgb: 0, 0, 0;
  --try-edge: transparent;
  --bar-slot: 44px;
  --bar-pad: 6px;
  --bar-gap: 4px;
  --g-blur: 14px;
  --g-sat: 160%;
  --g-bright: 100%;
  --g-edge-hi: 0.55;
  --g-edge-lo: 0.06;
  --g-edge-far: 0.22;
  --g-spec: 0.22;
  --g-lift: 0.45;
  --g-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.22),
    0 10px 40px rgba(0, 0, 0, 0.45);
}

/* ── glass navigation ──────────────────────────────────────
   Same recipe as .gcard: frost, refraction, lit inner edge.
   Shapes differ, the material does not. */
.gnav {
  position: relative;
  background: var(--pane);
  -webkit-backdrop-filter:
    blur(var(--g-blur, 2px)) saturate(var(--g-sat, 150%)) brightness(var(--g-bright, 100%));
  backdrop-filter:
    blur(var(--g-blur, 2px)) saturate(var(--g-sat, 150%)) brightness(var(--g-bright, 100%));
  isolation: isolate;
  color: var(--ink);
  --slot: var(--bar-slot);
  --nav-pad: var(--bar-pad);
  display: inline-flex;
  gap: var(--bar-gap);
  padding: var(--nav-pad);
  border-radius: var(--gnav-r, 999px);}

.gnav::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  /* transparent unless the rim below paints it */
  border: 1px solid transparent;
  pointer-events: none;
  z-index: 3;}

.gnav[data-orientation="vertical"] { flex-direction: column; border-radius: var(--gnav-r, 30px); }

.gnav-ind {
  position: absolute;
  top: var(--nav-pad);
  left: 0;
  height: calc(100% - var(--nav-pad) * 2);
  border-radius: var(--gnav-r, 999px);
  /* Just a wash — no border, no inset highlight, no penumbra,
     and no frost of its own. The pane underneath already
     carries the glass; stacking a second lit surface on top
     of it made the indicator read as a white lozenge floating
     over the bar rather than a selected slot in it.

     The active icon going from 0.42 to full opacity is doing
     most of the work, so this only has to hint at the slot. */
  background: var(--pane-thumb);
  pointer-events: none;
  will-change: transform, width;}

.gnav[data-orientation="vertical"] .gnav-ind {
  top: 0;
  left: var(--nav-pad);
  width: calc(100% - var(--nav-pad) * 2);
  height: auto;}

/* Two phases, two rules, and every number in them now comes
   from the component — durations off one rate, and the settle
   curve's overshoot off one Bounce. The fallbacks are the
   values this was tuned at, so the bar still moves correctly
   if it is ever mounted without them. */
.gnav-ind[data-phase="stretch"] {
  --d: var(--ind-stretch, 190ms);
  transition:
    transform var(--d) cubic-bezier(0.32, 0.72, 0.24, 1),
    width var(--d) cubic-bezier(0.32, 0.72, 0.24, 1),
    height var(--d) cubic-bezier(0.32, 0.72, 0.24, 1);}

.gnav-ind[data-phase="settle"] {
  --d: var(--ind-settle, 420ms);
  transition:
    transform var(--d) var(--ind-move, cubic-bezier(0.28, 1.28, 0.36, 1)),
    width var(--d) var(--ind-size, cubic-bezier(0.24, 1.34, 0.38, 1)),
    height var(--d) var(--ind-size, cubic-bezier(0.24, 1.34, 0.38, 1));}

.gnav-ind[data-phase="idle"] { transition: none; }

.gnav-item {
  position: relative;
  z-index: 1;
  width: var(--slot, 38px); height: var(--slot, 38px);
  border: 0; border-radius: var(--gnav-r, 999px);
  background: none;
  color: var(--ink);
  opacity: 0.42;
  display: grid; place-items: center;
  cursor: pointer;
  transition: opacity 260ms cubic-bezier(0.32, 0.72, 0.24, 1);}

.gnav-item:hover { opacity: 0.72; }

.gnav-item[data-active="true"] { opacity: 1; }

.gnav-item:focus-visible { outline: 1.5px solid var(--ink); outline-offset: 2px; }

/* ── the rim ─────────────────────────────────────────────────
   A flat rim is the single clearest tell that a thing is a
   rectangle with a border rather than a pane with thickness:
   real edges are lit unevenly, and evenly lit ones read as ink.

   So the ring is a gradient — bright at the corner facing the
   light, almost nothing along the sides that run edge-on to it,
   and a second weaker catch at the far corner where the light
   has come through the pane and out again.

   Painting a gradient in a border needs the border box filled
   and the padding box punched out of it, which is what the
   two masks do: one covers the whole element, one covers only
   the inside, and compositing them apart leaves the rim. */
[data-surface="glass"] .gnav::before {
  border-color: transparent;
  background:
    linear-gradient(
      142deg,
      rgba(255, 255, 255, var(--g-edge-hi, 0)) 0%,
      rgba(255, 255, 255, var(--g-edge-lo, 0)) 26%,
      rgba(255, 255, 255, var(--g-edge-lo, 0)) 62%,
      rgba(255, 255, 255, var(--g-edge-far, 0)) 100%
    ) border-box;
  -webkit-mask:
    linear-gradient(#000 0 0) padding-box,
    linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask:
    linear-gradient(#000 0 0) padding-box,
    linear-gradient(#000 0 0);
  mask-composite: exclude;}

/* ── thickness ───────────────────────────────────────────────
   The lit line along the top is where light enters the edge of
   a real sheet. The ring is the sheet's own thickness seen from
   straight on. The shadow underneath says the pane is ABOVE the
   page rather than painted onto it — the one thing a
   backdrop-filter alone can never say, because a filter has no
   depth. */
[data-surface="glass"] .gnav {
  box-shadow: var(--g-shadow,
    inset 0 1px 0 rgba(255, 255, 255, var(--g-spec, 0)),
    0 10px 40px rgba(var(--shadow-rgb), var(--g-lift, 0)));}


/* Ajustes responsive mobile-first para WOLSKIA */
*, *::before, *::after { box-sizing: border-box; }
html, body, #root { width: 100%; max-width: 100%; min-width: 0; }
body { overflow-x: clip; }
img, video, iframe, canvas, svg { max-width: 100%; }
button, a, input, textarea, select { touch-action: manipulation; }
button, [role="button"], a { min-height: 44px; }

@media (max-width: 767px) {
  .wol-aurora { width: 100%; min-width: 0; overflow: hidden; }
  .wol-aurora main, .wol-aurora section, .wol-aurora article, .wol-aurora form { min-width: 0; max-width: 100%; }
  .wol-aurora header { gap: 0.5rem; padding: 0.75rem 0.875rem; }
  .wol-aurora header img { flex-shrink: 0; }
  .wol-aurora header > div { min-width: 0; }
  .wol-aurora .glass { border-radius: 1.25rem; }
  .wol-suggest { min-height: 48px; padding: 0.8rem 0.9rem; white-space: normal; overflow-wrap: anywhere; }
  .wol-msg { max-width: 100%; overflow-wrap: anywhere; }
  .wol-aurora input, .wol-aurora textarea, .wol-aurora select { max-width: 100%; font-size: 16px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
}

/* Correcciones de composición en pantallas pequeñas: el contenido se adapta
   a la altura disponible sin superponer la bienvenida, mascota y compositor. */
@media (max-width: 767px) {
  .wol-aurora > section { min-height: 0; }
  .wol-aurora > section > div { min-height: 0; }
  .wol-aurora .glass { min-height: 0; padding: 1rem 0.875rem; }
  .wol-aurora .glass h1 { white-space: normal; overflow-wrap: anywhere; line-height: 1.2; }
  .wol-aurora .glass > p { overflow: visible; }
  .wol-aurora .glass form input:not([type="file"]) { display: block; width: 100%; min-width: 0; flex: 1 1 0%; opacity: 1; visibility: visible; position: relative; z-index: 1; }
  .wol-aurora .glass form button { min-height: 44px; }
  .wol-aurora .glass form button[aria-label="Adjuntar archivos"] { width: 44px; }
  /* Los chips de sugerencias se ocultan en celular; la barra de escribir NUNCA. */
  .wol-aurora .glass > [data-chat-chips] { display: none; }
  .wol-aurora .glass > [data-chat-composer] { display: block; flex-shrink: 0; visibility: visible; opacity: 1; }
}

@media (max-width: 420px) {
  .wol-aurora header { padding-inline: 0.75rem; }
  .wol-aurora .glass { padding-inline: 0.75rem; }
  .wol-aurora .glass form { gap: 0.35rem; flex-wrap: nowrap; }
  .wol-aurora .glass form input:not([type="file"]) { padding-inline: 0.4rem; font-size: 16px; }
  .wol-aurora .glass form .wol-btn { position: relative; z-index: 2; flex-shrink: 0; }
  .wol-aurora .glass form .wol-btn { padding-inline: 0.65rem; }
}

/* ═══ Chat en celular: todo entra en pantalla, nada se pisa ═══
   La zona central (.wol-stage) ocupa lo que sobra entre el saludo y la barra
   de escribir; el robot se dimensiona con ese alto (cqh) para no tapar nada. */
.wol-robot-fit { width: 9rem; height: 9rem; }

@media (max-width: 767px) {
  .wol-stage { container-type: size; }
  .wol-robot-fit {
    --fit: clamp(4.5rem, min(9rem, calc(100cqh - 2.75rem)), 9rem);
    width: var(--fit);
    height: var(--fit);
  }
  .wol-aurora .glass h1 { font-size: 1.5rem; }
  .wol-aurora .glass form { padding: 0.375rem; }
}

/* Pantallas bajas: se oculta el parrafo de bienvenida para dar lugar al robot */
@media (max-width: 767px) and (max-height: 720px) {
  .wol-aurora .glass .wol-lead { display: none; }
}
